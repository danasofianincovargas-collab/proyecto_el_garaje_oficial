# Plantilla de variables de entorno - El Garaje Backend
# Copia este archivo como ".env" y reemplaza los valores con tus credenciales reales.
# NUNCA subas el archivo ".env" real a un repositorio.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=el_garaje_db
PORT=3000

# Clave secreta para firmar los tokens JWT de sesion. Cambiala en produccion.
JWT_SECRET=cambia_esta_clave_secreta
JWT_EXPIRES_IN=8h
